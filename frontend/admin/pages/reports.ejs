    async function saveGeneralReportEdit(id) {
        const updatedData = {
            report_date: allReports.find(r => r.id === id).report_date,
            ops_summary: document.getElementById('edit_ops_summary').value,
            ops_installs: parseInt(document.getElementById('edit_ops_installs').value) || 0,
            ops_pending: parseInt(document.getElementById('edit_ops_pending').value) || 0,
            staff_summary: document.getElementById('edit_staff_summary').value,
            support_summary: document.getElementById('edit_support_summary').value,
            is_urgent: document.getElementById('edit_is_urgent').checked ? 1 : 0,
            conclusion: document.getElementById('edit_conclusion').value,
            status: document.getElementById('edit_status').value
        };

        try {
            const response = await fetch(`/api/reports/general/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(updatedData)
            });

            const data = await response.json();

            if (data.success) {
                showToast('Report updated successfully', 'success');
                fetchGeneralReports();
            } else {
                showToast('Failed to update report', 'error');
            }
        } catch (error) {
            console.error('Error updating report:', error);
            showToast('Failed to update report', 'error');
        }
    }

    async function deleteGeneralReport(id) {
        if (!confirm('Are you sure you want to delete this report? This action cannot be undone.')) {
            return;
        }

        try {
            const response = await fetch(`/api/reports/general/${id}`, {
                method: 'DELETE'
            });

            const data = await response.json();

            if (data.success) {
                showToast('Report deleted successfully', 'success');
                fetchGeneralReports();
            } else {
                showToast('Failed to delete report', 'error');
            }
        } catch (error) {
            console.error('Error deleting report:', error);
            showToast('Failed to delete report', 'error');
        }
    }

    function addPdfHeader(doc, subtitle) {
        const W = doc.internal.pageSize.getWidth();

        // Brand name
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(10);
        doc.setTextColor(0, 0, 0);
        doc.text(BRAND.name.toUpperCase(), 14, 10);

        // Thin divider line
        doc.setDrawColor(0, 0, 0);
        doc.setLineWidth(0.2);
        doc.line(14, 14, W - 14, 14);

        // Subtitle
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(11);
        doc.setTextColor(0, 0, 0);
        doc.text(subtitle.toUpperCase(), 14, 22);

        return 28;
    }

    function addPdfFooter(doc) {
        const n = doc.internal.getNumberOfPages();
        const W = doc.internal.pageSize.getWidth();
        const H = doc.internal.pageSize.getHeight();
        for (let i = 1; i <= n; i++) {
            doc.setPage(i);
            doc.setDrawColor(0, 0, 0);
            doc.setLineWidth(0.2);
            doc.line(14, H - 11, W - 14, H - 11);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(7.5);
            doc.setTextColor(0, 0, 0);
            doc.text('DR.NET TECHNOLOGY LABS  —  CONFIDENTIAL', 14, H - 6);
            doc.text(`Page ${i} of ${n}`, W - 14, H - 6, { align: 'right' });
        }
    }

    function fmt(n) { return Number(n || 0).toLocaleString(); }
    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    async function downloadGeneralReportPDF(id) {
        const report = allReports.find(r => r.id === id);
        if (!report) return;

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const W = doc.internal.pageSize.getWidth();

        let y = addPdfHeader(doc, 'DAILY GENERAL REPORT');

        // Meta
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.setTextColor(0, 0, 0);
        doc.text(`Report #${report.id}   |   Date: ${new Date(report.report_date).toLocaleDateString()}`, 14, y);
        doc.text(`Prepared by: ${report.first_name} ${report.second_name}  —  ${report.position || ''}`, 14, y + 5);
        doc.setFont('helvetica', 'bold');
        doc.text(`Status: ${(report.status || '').toUpperCase()}     Priority: ${report.is_urgent ? 'URGENT' : 'NORMAL'}`, 14, y + 10);
        y += 17;

        // Section builder
        function genSection(title, body, extraFn) {
            if (y > 242) { doc.addPage(); y = addPdfHeader(doc, 'DAILY GENERAL REPORT (CONT.)') + 4; }

            doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.setTextColor(0, 0, 0);
            doc.text(title.toUpperCase(), 14, y + 5);
            doc.setDrawColor(0, 0, 0); doc.setLineWidth(0.2);
            doc.line(14, y + 7, W - 14, y + 7);
            y += 12;

            doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
            const lines = doc.splitTextToSize(body || 'No summary provided.', W - 28);
            doc.text(lines, 14, y);
            y += lines.length * 5 + 4;
            if (extraFn) extraFn();
            y += 5;
        }

        genSection('1.  OPERATIONS & LOGISTICS', report.ops_summary, () => {
            if (y > 250) { doc.addPage(); y = addPdfHeader(doc, 'DAILY GENERAL REPORT (CONT.)') + 4; }

            doc.setFont('helvetica', 'bold'); doc.setFontSize(9);
            doc.text('INSTALLATIONS:', 14, y + 5);
            doc.setFont('helvetica', 'normal');
            doc.text(String(report.ops_installs || 0), 45, y + 5);

            doc.setFont('helvetica', 'bold');
            doc.text('PENDING JOBS:', 80, y + 5);
            doc.setFont('helvetica', 'normal');
            doc.text(String(report.ops_pending || 0), 110, y + 5);

            y += 10;
        });

        genSection('2.  STAFF & PERSONNEL', report.staff_summary);
        genSection('3.  SUPPORT & CLIENT FEEDBACK', report.support_summary);

        if (y > 232) { doc.addPage(); y = addPdfHeader(doc, 'DAILY GENERAL REPORT (CONT.)') + 4; }
        doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.setTextColor(0, 0, 0);
        doc.text('4.  CONCLUSION & ACTION ITEMS', 14, y + 5);
        doc.setDrawColor(0, 0, 0); doc.setLineWidth(0.2);
        doc.line(14, y + 7, W - 14, y + 7);
        y += 12;

        const cLines = doc.splitTextToSize(report.conclusion || 'No conclusion provided.', W - 28);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(9);
        doc.text(cLines, 14, y);
        y += cLines.length * 5;

        addPdfFooter(doc);
        doc.save(`DR.NET-General-Report-${report.id}.pdf`);
        showToast('PDF downloaded successfully', 'success');
    }

    // ANALYTICS TAB FUNCTIONS

    function updateDateRange() {
        const period = document.getElementById('reportPeriod').value;
        document.getElementById('customDateRange').classList.toggle('hidden', period !== 'custom');
    }

    async function generateAnalyticsReport() {
        const period = document.getElementById('reportPeriod').value;
        const format = document.querySelector('input[name="exportFormat"]:checked').value;
        const dateFrom = document.getElementById('dateFrom').value;
        const dateTo = document.getElementById('dateTo').value;
        const customYear = document.getElementById('customYear')?.value;
        const customMonth = document.getElementById('customMonth')?.value;

        const params = new URLSearchParams({ period });

        if (period === 'custom') {
            const isRange = document.getElementById('modeRange')?.checked;
            if (isRange && dateFrom && dateTo) {
                params.set('date_from', dateFrom);
                params.set('date_to', dateTo);
            } else if (customYear && customMonth) {
                params.set('year', customYear);
                params.set('month', customMonth);
            } else {
                showToast('Please fill in the custom period fields', 'error');
                return;
            }
        }

        document.getElementById('analyticsPreview').innerHTML = `
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;color:#94a3b8">
                    <i class="fas fa-circle-notch fa-spin" style="font-size:2.2rem;margin-bottom:14px;color:#F0177A"></i>
                    <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0">Building Report…</p>
                </div>`;

        try {
            const res = await fetch(`/api/reports/analytics?${params.toString()}`);
            const result = await res.json();
            if (!result.success) {
                showToast(result.message || 'Failed to generate report', 'error');
                return;
            }
            currentAnalyticsData = result.data;
            currentActiveReportType = 'analytics';
            displayAnalyticsPreview(result.data);
            if (format === 'pdf') generateAnalyticsPDF(result.data);
            document.getElementById('downloadReportBtn').classList.remove('hidden');
        } catch (err) {
            console.error(err);
            showToast('Failed to generate report', 'error');
        }
    }



