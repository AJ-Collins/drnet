            doc.text(`Page ${i} of ${pageCount}`, W - margin, H - 7, { align: 'right' });
        }

        doc.save(`DR.NET-DashboardReport-${meta.period_label.replace(/ /g, '-')}.pdf`);
        showToast('PDF downloaded successfully', 'success');
    }

    function downloadCurrentReport() {
        if (currentActiveReportType === 'dashboard' && currentDashboardData) {
            generateDashboardPDF(currentDashboardData);
        } else if (currentActiveReportType === 'analytics' && currentAnalyticsData) {
            generateAnalyticsPDF(currentAnalyticsData);
        } else {
            showToast('No report to download', 'error');
        }
    }

    function showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `px-6 py-3 rounded-lg shadow-lg text-white text-sm font-bold animate-fade-in ${type === 'success' ? 'bg-emerald-600' :
            type === 'error' ? 'bg-red-600' :
                'bg-blue-600'
            }`;
        toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'} mr-2"></i>
                ${message}
            `;

        document.getElementById('toastContainer').appendChild(toast);

        setTimeout(() => {
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }
</script>