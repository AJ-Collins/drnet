    async function runGlobalBackfill() {
        if (!confirm('Run a full backfill of historical analytics data? This will scan all past records but will not overwrite your manual adjustments.')) return;

        try {
            showToast('Starting backfill... this may take a moment', 'info');
            const res = await fetch('/api/reports/analytics/monthly/backfill', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({})
            });
            const result = await res.json();

            if (result.success) {
                showToast(`Backfill complete: ${result.created} months processed.`, 'success');
            } else {
                showToast(result.message || 'Failed to complete backfill', 'error');
            }
        } catch (e) {
            console.error(e);
            showToast('Error running backfill', 'error');
        }
    }

