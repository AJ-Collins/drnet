                    <span><span class="inline-block w-2 h-2 rounded-full bg-teal-400 mr-1"></span>Teal columns = Hotspot
                        manual entry (editable)</span>
                    <span><span class="inline-block w-2 h-2 rounded-full bg-emerald-400 mr-1"></span>Emerald column =
                        Revenue
                        Injection (editable)</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse" style="min-width:1100px">
                        <thead class="bg-slate-800 text-white text-[10px] font-black uppercase tracking-wider">
                            <tr>
                                <th class="px-3 py-3 sticky left-0 bg-slate-800 z-10">Month</th>
                                <th class="px-3 py-3 text-right text-slate-400">Computed Sub Rev</th>
                                <th class="px-3 py-3 text-right text-indigo-300">Adj Sub Rev ✎</th>
                                <th class="px-3 py-3 text-right text-slate-400">Computed Sales</th>
                                <th class="px-3 py-3 text-right text-indigo-300">Adj Sales ✎</th>
                                <th class="px-3 py-3 text-right text-slate-400">Computed Exp</th>
                                <th class="px-3 py-3 text-right text-indigo-300">Adj Exp ✎</th>
                                <th class="px-3 py-3 text-right text-slate-400">Computed Salaries</th>
                                <th class="px-3 py-3 text-right text-indigo-300">Adj Salaries ✎</th>
                                <th class="px-3 py-3 text-right text-teal-300">Hotspot Rev ✎</th>
