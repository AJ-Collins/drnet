                    <button onclick="runGlobalBackfill()"
                        class="px-4 py-2 bg-indigo-500 text-white rounded text-[10px] font-bold hover:bg-indigo-400 uppercase shadow-sm">
                        <i class="fas fa-database mr-1"></i> Global Backfill
