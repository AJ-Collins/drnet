                        <button onclick="generateDashboardReport()"
                            class="w-full bg-gray-400 text-white py-3 rounded-lg font-bold text-sm hover:bg-gray-500 shadow-lg uppercase">
                            <i class="fas fa-tachometer-alt mr-2"></i>Generate Stats Report
                        </button>

