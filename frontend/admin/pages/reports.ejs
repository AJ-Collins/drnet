                            <!-- Toggle: month picker vs date range -->
                            <div>
                                <label class="text-[10px] font-bold uppercase text-slate-400 mb-2 block">Custom
                                    Type</label>
                                <div class="flex gap-2">
                                    <label class="flex-1 cursor-pointer">
                                        <input type="radio" name="customMode" id="modeMonth" value="month" checked
