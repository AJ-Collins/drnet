    async function loadAllMonthlyData() {
        const tbody = document.getElementById('monthlyDataTableBody');
        tbody.innerHTML = `<tr><td colspan="14" class="px-4 py-10 text-center text-slate-400"><i class="fas fa-circle-notch fa-spin text-2xl mb-2 block"></i><p class="text-[10px] font-bold uppercase">Loading...</p></td></tr>`;
        try {
            console.log('Fetching monthly analytics data...');
            const res = await fetch('/api/reports/analytics/monthly');
            const result = await res.json();
            console.log('Monthly data response:', result);

            if (result.success && result.data && result.data.length > 0) {
                console.log('Rendering', result.data.length, 'rows');

                // Explicitly sort by year DESC and month DESC
                result.data.sort((a, b) => {
                    if (b.year !== a.year) return b.year - a.year;
                    return b.month - a.month;
                });

                monthlyData = result.data;
                monthlyCurrentPage = 1;
                renderMonthlyTablePage();
                console.log('Table HTML updated successfully.');
            } else {
                monthlyData = [];
                renderMonthlyTablePage();
            }
        } catch (e) {
            console.error('Error loading monthly data:', e);
            showToast('Failed to load monthly database', 'error');
        }
    }

    function renderMonthlyTablePage() {
        const tbody = document.getElementById('monthlyDataTableBody');
        if (!monthlyData || monthlyData.length === 0) {
            tbody.innerHTML = `<tr><td colspan="14" class="px-4 py-8 text-center text-xs font-bold text-slate-400 uppercase">No monthly data found. Run Global Backfill to populate.</td></tr>`;
            document.getElementById('monthlyPaginationContainer').innerHTML = '';
            return;
        }

        const startIndex = (monthlyCurrentPage - 1) * monthlyRowsPerPage;
        const endIndex = startIndex + monthlyRowsPerPage;
        const pageData = monthlyData.slice(startIndex, endIndex);

        let html = '';
        for (let i = 0; i < pageData.length; i++) {
            html += renderMonthRow(pageData[i]);
        }
        tbody.innerHTML = html;

        renderMonthlyPagination();
    }

    function renderMonthlyPagination() {
        const totalPages = Math.ceil(monthlyData.length / monthlyRowsPerPage);
        let paginationContainer = document.getElementById('monthlyPaginationContainer');

        if (totalPages <= 1) {
            paginationContainer.innerHTML = '';
            return;
        }

        let html = `
            <span class="text-xs text-slate-500 font-bold">
                Showing ${(monthlyCurrentPage - 1) * monthlyRowsPerPage + 1} to ${Math.min(monthlyCurrentPage * monthlyRowsPerPage, monthlyData.length)} of ${monthlyData.length} entries
            </span>
            <div class="flex gap-1">
                <button onclick="changeMonthlyPage(${monthlyCurrentPage - 1})" class="px-3 py-1.5 rounded border border-slate-200 text-xs font-bold ${monthlyCurrentPage === 1 ? 'bg-slate-100 text-slate-400 cursor-not-allowed' : 'bg-white text-slate-700 hover:bg-slate-50'}" ${monthlyCurrentPage === 1 ? 'disabled' : ''}>Prev</button>
        `;

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= monthlyCurrentPage - 1 && i <= monthlyCurrentPage + 1)) {
                html += `<button onclick="changeMonthlyPage(${i})" class="px-3 py-1.5 rounded border border-slate-200 text-xs font-bold ${i === monthlyCurrentPage ? 'bg-indigo-600 text-white border-indigo-600' : 'bg-white text-slate-700 hover:bg-slate-50'}">${i}</button>`;
            } else if (i === monthlyCurrentPage - 2 || i === monthlyCurrentPage + 2) {
                html += `<span class="px-2 py-1.5 text-slate-400">...</span>`;
            }
        }

        html += `
                <button onclick="changeMonthlyPage(${monthlyCurrentPage + 1})" class="px-3 py-1.5 rounded border border-slate-200 text-xs font-bold ${monthlyCurrentPage === totalPages ? 'bg-slate-100 text-slate-400 cursor-not-allowed' : 'bg-white text-slate-700 hover:bg-slate-50'}" ${monthlyCurrentPage === totalPages ? 'disabled' : ''}>Next</button>
            </div>
        `;
        paginationContainer.innerHTML = html;
    }

    function changeMonthlyPage(page) {
        const totalPages = Math.ceil(monthlyData.length / monthlyRowsPerPage);
        if (page < 1 || page > totalPages) return;
        monthlyCurrentPage = page;
        renderMonthlyTablePage();
    }

    function getReadCell(val, color) {
        return `<td class="px-3 py-2.5 text-right font-bold ${color}">KES ${fmt(val)}</td>`;
    }

    function getEditCell(id, field, val, rowYear, rowMonth, step) {
        const numVal = Number(val || 0);
        return `<td class="px-2 py-1.5 editable-cell">
            <input type="number" step="${step}" id="${id}_${field}" value="${numVal}" onkeydown="if(event.key==='Enter')saveMonthRow('${rowYear}','${rowMonth}')">
        </td>`;
    }

    function renderMonthRow(row) {
        try {
            const monthName = new Date(row.year, row.month - 1).toLocaleString('default', { month: 'long' });
            const lastComp = row.last_computed_at ? new Date(row.last_computed_at).toLocaleString() : '—';
            const id = `${row.year}_${row.month}`;

            return `
            <tr class="monthly-row" data-year="${row.year}" data-month="${row.month}">
                <td class="px-3 py-2.5 font-black text-slate-800 whitespace-nowrap sticky left-0 bg-white border-r border-slate-100">${monthName} ${row.year}</td>
                ${getReadCell(row.computed_subscription_revenue, 'text-slate-700')}
                ${getEditCell(id, 'adj_sub_rev', row.adjustment_subscription_revenue, row.year, row.month, '0.01')}
                ${getReadCell(row.computed_sales_revenue, 'text-slate-700')}
                ${getEditCell(id, 'adj_sales_rev', row.adjustment_sales_revenue, row.year, row.month, '0.01')}
                ${getReadCell(row.computed_hrexpenses, 'text-slate-700')}
                ${getEditCell(id, 'adj_hrexp', row.adjustment_hrexpenses, row.year, row.month, '0.01')}
                ${getReadCell(row.computed_staff_salaries, 'text-slate-700')}
                ${getEditCell(id, 'adj_salaries', row.adjustment_staff_salaries, row.year, row.month, '0.01')}
                ${getEditCell(id, 'hotspot_rev', row.hotspot_revenue, row.year, row.month, '0.01')}
                ${getEditCell(id, 'hotspot_subs', row.hotspot_subscriptions_count, row.year, row.month, '1')}
                ${getEditCell(id, 'revenue_injection', row.revenue_injection, row.year, row.month, '0.01')}
                <td class="px-3 py-2.5 text-center text-[10px] text-slate-400 whitespace-nowrap">${lastComp}</td>
                <td class="px-3 py-2.5 text-center">
                    <div class="flex items-center justify-center gap-1">
                        <button onclick="saveMonthRow('${row.year}','${row.month}')" title="Save" class="px-2.5 py-1.5 bg-indigo-600 text-white rounded text-[10px] font-bold hover:bg-indigo-700 uppercase">
                            <i class="fas fa-save"></i>
                        </button>
                        <button onclick="recomputeMonthRow('${row.year}','${row.month}')" title="Re-pull system data" class="px-2.5 py-1.5 bg-slate-600 text-white rounded text-[10px] font-bold hover:bg-slate-700 uppercase">
                            <i class="fas fa-calculator"></i>
                        </button>
                        <button onclick="deleteMonthRow('${row.year}','${row.month}')" title="Delete row" class="px-2.5 py-1.5 bg-red-600 text-white rounded text-[10px] font-bold hover:bg-red-700 uppercase">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>`;
        } catch (e) {
            console.error('Error rendering row:', row, e);
            return `<tr><td colspan="14" class="text-red-500 text-center py-4">Error rendering row for ${row.year}-${row.month}</td></tr>`;
        }
    }

    async function saveMonthRow(year, month) {
        const id = `${year}_${month}`;
        const tr = document.querySelector(`tr[data-year="${year}"][data-month="${month}"]`);
        if (tr) tr.classList.add('saving');

        const body = {
            adjustments: {
                subscription_revenue: parseFloat(document.getElementById(`${id}_adj_sub_rev`)?.value) || 0,
                sales_revenue: parseFloat(document.getElementById(`${id}_adj_sales_rev`)?.value) || 0,
                hrexpenses: parseFloat(document.getElementById(`${id}_adj_hrexp`)?.value) || 0,
                staff_salaries: parseFloat(document.getElementById(`${id}_adj_salaries`)?.value) || 0,
            },
            hotspot_revenue: parseFloat(document.getElementById(`${id}_hotspot_rev`)?.value) || 0,
            hotspot_subscriptions_count: parseInt(document.getElementById(`${id}_hotspot_subs`)?.value) || 0,
            revenue_injection: parseFloat(document.getElementById(`${id}_revenue_injection`)?.value) || 0,
        };

        try {
            const res = await fetch(`/api/reports/analytics/monthly/${year}/${month}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const result = await res.json();
            if (result.success) {
                showToast(`${new Date(year, month - 1).toLocaleString('default', { month: 'long' })} ${year} saved`, 'success');

                const dataIndex = monthlyData.findIndex(r => r.year === Number(year) && r.month === Number(month));
                if (dataIndex !== -1) monthlyData[dataIndex] = result.data;

                // Re-render just this row with fresh data
                if (tr) tr.outerHTML = renderMonthRow(result.data);
            } else {
                showToast(result.message || 'Save failed', 'error');
            }
        } catch (e) {
            console.error(e);
            showToast('Error saving row', 'error');
        } finally {
            const updatedTr = document.querySelector(`tr[data-year="${year}"][data-month="${month}"]`);
            if (updatedTr) updatedTr.classList.remove('saving');
        }
    }

    async function recomputeMonthRow(year, month) {
        const tr = document.querySelector(`tr[data-year="${year}"][data-month="${month}"]`);
        if (tr) tr.classList.add('saving');
        try {
            const res = await fetch(`/api/reports/analytics/monthly/${year}/${month}/recompute`, { method: 'POST' });
            const result = await res.json();
            if (result.success) {
                showToast('System data re-pulled', 'success');

                const dataIndex = monthlyData.findIndex(r => r.year === Number(year) && r.month === Number(month));
                if (dataIndex !== -1) monthlyData[dataIndex] = result.data;

                if (tr) tr.outerHTML = renderMonthRow(result.data);
            } else {
                showToast(result.message || 'Recompute failed', 'error');
            }
        } catch (e) {
            console.error(e);
            showToast('Error recomputing', 'error');
        } finally {
            const updatedTr = document.querySelector(`tr[data-year="${year}"][data-month="${month}"]`);
            if (updatedTr) updatedTr.classList.remove('saving');
        }
    }

    async function deleteMonthRow(year, month) {
        const monthName = new Date(year, month - 1).toLocaleString('default', { month: 'long' });
        if (!confirm(`Delete the ${monthName} ${year} analytics row? This cannot be undone.`)) return;
        const tr = document.querySelector(`tr[data-year="${year}"][data-month="${month}"]`);
        if (tr) tr.classList.add('saving');
        try {
            const res = await fetch(`/api/reports/analytics/monthly/${year}/${month}`, { method: 'DELETE' });
            const result = await res.json();
            if (result.success) {
                showToast(`${monthName} ${year} row deleted`, 'success');

                monthlyData = monthlyData.filter(r => !(r.year === Number(year) && r.month === Number(month)));
                renderMonthlyTablePage();
            } else {
                showToast(result.message || 'Delete failed', 'error');
                if (tr) tr.classList.remove('saving');
            }
        } catch (e) {
            console.error(e);
            showToast('Error deleting row', 'error');
            if (tr) tr.classList.remove('saving');
        }
    }

