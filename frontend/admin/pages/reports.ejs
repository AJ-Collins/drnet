    function generateAnalyticsPDF(data) {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const { meta, financial, clients } = data;
        const W = doc.internal.pageSize.getWidth();
        const margin = 15;

        // Helper for lines
        let y = 15;

        // Header
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(18);
        doc.setTextColor(30, 41, 59);
        doc.text('MONTHLY REPORT', margin, y);

        y += 8;
        doc.setFontSize(10);
        doc.setTextColor(100, 116, 139);
        doc.text(BRAND.name.toUpperCase(), margin, y);

        doc.setFont('helvetica', 'normal');
        doc.text(`Period: ${meta.period_label}`, W - margin, y, { align: 'right' });

        y += 5;
        doc.setDrawColor(30, 41, 59);
        doc.setLineWidth(1);
        doc.line(margin, y, W - margin, y);

        y += 15;

        // Section 1: Revenue
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.setTextColor(30, 41, 59);
        doc.text('1. REVENUE OVERVIEW', margin, y);
        y += 5;
        doc.setLineWidth(0.5);
        doc.line(margin, y, W - margin, y);
        y += 10;

        const revenueRows = [
            ['Subscription Revenue', `KES ${fmt(financial.subscription_revenue)}`],
            ['Sales Revenue', `KES ${fmt(financial.sales_revenue)}`],
            ['TOTAL REVENUE', `KES ${fmt(financial.total_revenue)}`]
        ];

        doc.autoTable({
            startY: y,
            body: revenueRows,
            theme: 'plain',
            styles: { fontSize: 10, cellPadding: 3 },
            columnStyles: { 1: { halign: 'right' } },
            didParseCell: function (data) {
                if (data.row.index === 2) {
                    data.cell.styles.fontStyle = 'bold';
                    data.cell.styles.fillColor = [241, 245, 249];
                }
            }
        });

        y = doc.lastAutoTable.finalY + 15;

        // Section 2: Expenditure
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.text('2. EXPENDITURE & DEDUCTIONS', margin, y);
        y += 5;
        doc.line(margin, y, W - margin, y);
        y += 10;

        const expenseRows = [
            ['Staff Salaries', `KES ${fmt(financial.staff_salaries_payable)}`],
            ['General Expenditure', `KES ${fmt(financial.monthly_expenditure)}`],
            ['TOTAL EXPENDITURE', `KES ${fmt(financial.total_expenditure)}`]
        ];

        doc.autoTable({
            startY: y,
            body: expenseRows,
            theme: 'plain',
            styles: { fontSize: 10, cellPadding: 3 },
            columnStyles: { 1: { halign: 'right' } },
            didParseCell: function (data) {
                if (data.row.index === 2) {
                    data.cell.styles.fontStyle = 'bold';
                    data.cell.styles.fillColor = [241, 245, 249];
                    data.cell.styles.textColor = [220, 38, 38];
                }
            }
        });

        y = doc.lastAutoTable.finalY + 15;

        // Section 3: Net Profit
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.text('3. PROFITABILITY ANALYSIS', margin, y);
        y += 5;
        doc.line(margin, y, W - margin, y);
        y += 10;

        doc.setFillColor(financial.net_profit >= 0 ? 240 : 254, financial.net_profit >= 0 ? 253 : 242, financial.net_profit >= 0 ? 244 : 242);
        doc.rect(margin, y, W - (margin * 2), 25, 'F');

        doc.setFontSize(10);
        doc.setTextColor(financial.net_profit >= 0 ? 21 : 153, financial.net_profit >= 0 ? 101 : 27, financial.net_profit >= 0 ? 52 : 27);
        doc.text('NET PROFIT / LOSS', margin + 5, y + 10);

        doc.setFontSize(18);
        doc.text(`KES ${financial.net_profit < 0 ? '-' : ''}${fmt(Math.abs(financial.net_profit))}`, margin + 5, y + 20);

        doc.setFontSize(10);
        doc.setTextColor(100, 116, 139);
        doc.text('PROFIT MARGIN', W - margin - 5, y + 10, { align: 'right' });
        doc.setFontSize(14);
        doc.setTextColor(30, 41, 59);
        doc.text(`${financial.profit_margin_pct}%`, W - margin - 5, y + 20, { align: 'right' });

        y += 35;

        // Section 4: Client Activity
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(12);
        doc.text('4. CLIENT ACTIVITY', margin, y);
        y += 5;
        doc.line(margin, y, W - margin, y);
        y += 10;

        const clientStats = [
            ['Total Clients Joined', String(clients.new_clients_count)],
            ['Total New Subscriptions', String(clients.new_subscriptions_count)]
        ];

        doc.autoTable({
            startY: y,
            body: clientStats,
            theme: 'plain',
            styles: { fontSize: 10, cellPadding: 3 },
            columnStyles: { 1: { halign: 'right', fontStyle: 'bold' } }
        });

        y = doc.lastAutoTable.finalY + 20;

        // Footer
        const pageCount = doc.internal.getNumberOfPages();
        for (let i = 1; i <= pageCount; i++) {
            doc.setPage(i);
            doc.setFontSize(8);
            doc.setTextColor(148, 163, 184);
            doc.text('DR.NET TECHNOLOGY LABS - INTERNAL REPORT', margin, doc.internal.pageSize.getHeight() - 10);
            doc.text(`Page ${i} of ${pageCount}`, W - margin, doc.internal.pageSize.getHeight() - 10, { align: 'right' });
        }

        doc.save(`DR.NET-Report-${meta.period_label.replace(/ /g, '-')}.pdf`);
        showToast('PDF downloaded successfully', 'success');
    }

    function downloadCurrentReport() {
        if (!currentAnalyticsData) { showToast('No report to download', 'error'); return; }
        generateAnalyticsPDF(currentAnalyticsData);
    }

    function showToast(message, type = 'info') {
        const toast = document.createElement('div');
        toast.className = `px-6 py-3 rounded-lg shadow-lg text-white text-sm font-bold animate-fade-in ${type === 'success' ? 'bg-emerald-600' :
            type === 'error' ? 'bg-red-600' :
                'bg-blue-600'
            }`;
        toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'} mr-2"></i>
                ${message}
            `;

        document.getElementById('toastContainer').appendChild(toast);

        setTimeout(() => {
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }        
</script>