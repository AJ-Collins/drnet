            <!-- Right: Preview Area -->
            <div id="previewWrapper" class="col-span-12 lg:col-span-8 xl:col-span-9">
                <div class="bg-white border border-slate-200 shadow-sm">
                    <div class="section-header px-4 py-3 flex items-center justify-between">
                        <h3 class="text-sm font-black text-white uppercase tracking-wide">
                            Report Preview
                        </h3>

                        <div class="flex items-center gap-2">
                            <button onclick="togglePreviewFullscreen()"
                                class="px-3 py-1 bg-white/10 text-white rounded text-[10px] font-bold hover:bg-white/20 uppercase flex items-center gap-1">
