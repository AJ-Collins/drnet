    function generateAnalyticsPDF(data) {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        const { meta, financial, clients } = data;
        const W = doc.internal.pageSize.getWidth();
        const margin = 15;

        // ── thin line helper ────────────────────────────────────────────────
        const thinLine = (yPos) => {
            doc.setDrawColor(0, 0, 0);
            doc.setLineWidth(0.2);
            doc.line(margin, yPos, W - margin, yPos);
        };

        // ── section heading helper ──────────────────────────────────────────
        // Prints bold uppercase title, then a thin rule beneath it.
        // Returns new y after the rule + gap.
        const sectionTitle = (title, yPos) => {
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(10);
            doc.setTextColor(0, 0, 0);
            doc.text(title, margin, yPos);
            thinLine(yPos + 2);
            return yPos + 9;
        };

        // ── data row helper ─────────────────────────────────────────────────
        // Prints a label-value pair on one line, optionally bold (for totals).
        const dataRow = (label, value, yPos, isBold = false) => {
            doc.setFont('helvetica', isBold ? 'bold' : 'normal');
            doc.setFontSize(10);
            doc.setTextColor(0, 0, 0);
            doc.text(label, margin, yPos);
            doc.text(value, W - margin, yPos, { align: 'right' });
            return yPos + 7;
        };

        // ═══════════════════════════════════════════════════════════════════
        // DOCUMENT HEADER
        // ═══════════════════════════════════════════════════════════════════
        let y = 16;

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(18);
        doc.setTextColor(0, 0, 0);
        doc.text('ANALYTICS REPORT', margin, y);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(9);
        doc.text(meta.period_label, W - margin, y, { align: 'right' });

        y += 5;
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
        doc.text(BRAND.name.toUpperCase(), margin, y);
        doc.text(`Generated: ${new Date(meta.generated_at).toLocaleString()}`, W - margin, y, { align: 'right' });

        y += 3;
        thinLine(y);
        y += 12;

        // ═══════════════════════════════════════════════════════════════════
        // 1. REVENUE OVERVIEW
        // ═══════════════════════════════════════════════════════════════════
        y = sectionTitle('1.  REVENUE OVERVIEW', y);
        y = dataRow('Subscription Revenue', `KES ${fmt(financial.subscription_revenue)}`, y);
        y = dataRow('Sales Revenue', `KES ${fmt(financial.sales_revenue)}`, y);
        y = dataRow('Hotspot Revenue', `KES ${fmt(financial.hotspot_revenue)}`, y);
        y = dataRow('TOTAL REVENUE', `KES ${fmt(financial.total_revenue)}`, y, true);
        y += 10;

        // ═══════════════════════════════════════════════════════════════════
        // 2. EXPENDITURE & DEDUCTIONS
        // ═══════════════════════════════════════════════════════════════════
        y = sectionTitle('2.  EXPENDITURE & DEDUCTIONS', y);
        y = dataRow('Staff Salaries', `KES ${fmt(financial.staff_salaries_payable)}`, y);
        y = dataRow('General Expenditure', `KES ${fmt(financial.monthly_expenditure)}`, y);
        y = dataRow('TOTAL EXPENDITURE', `KES ${fmt(financial.total_expenditure)}`, y, true);
        y += 10;

        // ═══════════════════════════════════════════════════════════════════
        // 3. REVENUE INJECTION
        // ═══════════════════════════════════════════════════════════════════
        y = sectionTitle('3.  REVENUE INJECTION', y);
        y = dataRow('Revenue Injection', `KES ${fmt(financial.revenue_injection || 0)}`, y, true);
        y += 3;
        doc.setFont('helvetica', 'italic');
        doc.setFontSize(7.5);
        doc.setTextColor(0, 0, 0);
        const injNote = doc.splitTextToSize(
            '* Revenue Injection is an independently recorded value and does not affect Total Revenue, Expenditure, or Net Profit.',
            W - margin * 2
        );
        doc.text(injNote, margin, y);
        y += injNote.length * 4 + 10;

        // ═══════════════════════════════════════════════════════════════════
        // 4. PROFITABILITY ANALYSIS
        // ═══════════════════════════════════════════════════════════════════
        y = sectionTitle('4.  PROFITABILITY ANALYSIS', y);

        // Net Profit / Loss — large text, two-column layout
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(8);
        doc.setTextColor(0, 0, 0);
        doc.text('NET PROFIT / LOSS', margin, y);
        doc.text('PROFIT MARGIN', W - margin, y, { align: 'right' });
        y += 8;

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(16);
        doc.text(
            `KES ${financial.net_profit < 0 ? '-' : ''}${fmt(Math.abs(financial.net_profit))}`,
            margin, y
        );
        doc.setFontSize(16);
        doc.text(`${financial.profit_margin_pct}%`, W - margin, y, { align: 'right' });
        y += 10;

        doc.setFont('helvetica', 'italic');
        doc.setFontSize(7.5);
        doc.setTextColor(0, 0, 0);
        const profNote = doc.splitTextToSize(
            '* Net Profit is the remaining balance after deducting all expenditures (including salaries) from total revenue.',
            W - margin * 2
        );
        doc.text(profNote, margin, y);
        y += profNote.length * 4 + 12;

        // ═══════════════════════════════════════════════════════════════════
        // 5. CLIENT ACTIVITY
        // ═══════════════════════════════════════════════════════════════════
        y = sectionTitle('5.  CLIENT ACTIVITY', y);
        y = dataRow('Total Clients Joined', String(clients.new_clients_count), y);
        y = dataRow('Total New Subscriptions', String(clients.new_subscriptions_count), y);
        y = dataRow('Hotspot Subscriptions', String(clients.hotspot_subscriptions_count), y);
        y += 5;

        // ═══════════════════════════════════════════════════════════════════
        // FOOTER
        // ═══════════════════════════════════════════════════════════════════
        const pageCount = doc.internal.getNumberOfPages();
        const H = doc.internal.pageSize.getHeight();
        for (let i = 1; i <= pageCount; i++) {
            doc.setPage(i);
            thinLine(H - 12);
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(7.5);
            doc.setTextColor(0, 0, 0);
            doc.text('DR.NET TECHNOLOGY LABS  —  CONFIDENTIAL', margin, H - 7);
            doc.text(`Page ${i} of ${pageCount}`, W - margin, H - 7, { align: 'right' });
        }

        doc.save(`DR.NET-Report-${meta.period_label.replace(/ /g, '-')}.pdf`);
        showToast('PDF downloaded successfully', 'success');
    }

    async function generateDashboardReport() {
        const format = document.querySelector('input[name="exportFormat"]:checked').value;
        const period = document.getElementById('reportPeriod').value;
        const dateFrom = document.getElementById('dateFrom').value;
        const dateTo = document.getElementById('dateTo').value;
        const customYear = document.getElementById('customYear')?.value;
        const customMonth = document.getElementById('customMonth')?.value;

        const params = new URLSearchParams({ period });

        if (period === 'custom') {
            const isRange = document.getElementById('modeRange')?.checked;
            if (isRange && dateFrom && dateTo) {
                params.set('date_from', dateFrom);
                params.set('date_to', dateTo);
            } else if (customYear && customMonth) {
                params.set('year', customYear);
                params.set('month', customMonth);
            } else {
                showToast('Please fill in the custom period fields', 'error');
                return;
            }
        }

        document.getElementById('analyticsPreview').innerHTML = `
                <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 20px;color:#94a3b8">
                    <i class="fas fa-circle-notch fa-spin" style="font-size:2.2rem;margin-bottom:14px;color:#6366f1"></i>
                    <p style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;margin:0">Building Stats Report…</p>
                </div>`;

        try {
            const res = await fetch(`/api/reports/dashboard_report?${params.toString()}`);
            const result = await res.json();
            if (!result.success) {
                showToast(result.message || 'Failed to generate report', 'error');
                return;
            }
            currentActiveReportType = 'dashboard';
            currentDashboardData = result.data;
            displayDashboardPreview(result.data);
            if (format === 'pdf') generateDashboardPDF(result.data);
            document.getElementById('downloadReportBtn').classList.remove('hidden');
        } catch (err) {
            console.error(err);
            showToast('Failed to generate dashboard report', 'error');
        }
    }

