        <div class="bg-white border border-slate-200 shadow-sm mb-6">
            <div class="section-header px-4 py-3 flex justify-between items-center">
                <div>
                    <h3 class="text-sm font-black text-white uppercase tracking-wide">Monthly Analytics Data</h3>
                    <p class="text-[10px] text-slate-300 mt-0.5">Edit adjustment & hotspot fields directly in the table
                        — save per row.</p>
                </div>
                <div class="flex items-center gap-2">
                    <button onclick="loadAllMonthlyData()"
                        class="px-3 py-2 bg-white/10 text-white rounded text-[10px] font-bold hover:bg-white/20 uppercase">
